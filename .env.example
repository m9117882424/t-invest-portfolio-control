# T-Invest read-only token. Never commit real tokens.
T_INVEST_TOKEN=replace_with_read_only_token

# Run: python -m tinvest_portfolio accounts
T_INVEST_ACCOUNT_ID=

# Allowed values: READ_ONLY, ADVISORY, SANDBOX, LIVE_TRADING.
# Public version is intended for READ_ONLY usage.
APP_MODE=READ_ONLY

# Telegram notifications. Optional unless you run notify/watch.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Automation settings.
AUTOMATION_INTERVAL_MINUTES=30
DAILY_REPORT_TIMES=09:30,18:30
MIN_ALERT_BUDGET_RUB=1000
